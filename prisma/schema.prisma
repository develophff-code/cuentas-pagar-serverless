  @@unique([tenant_id, supplier_id, invoice_type, invoice_number], map: "invoices_fiscal_reference_key", where: raw("((invoice_type = ANY (ARRAY['A'::text, 'C'::text])) AND (status <> 'CANCELED'::invoice_status))"))
