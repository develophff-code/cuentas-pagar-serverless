  status                                                             invoice_status     @default(PENDING_REVIEW)
  raw_extraction_data                                                Json?
  created_by_user_id                                                 String?            @db.Uuid
  confirmed_by_user_id                                               String?            @db.Uuid
  canceled_by_user_id                                                String?            @db.Uuid
  canceled_at                                                        DateTime?          @db.Timestamptz(6)
  cancellation_reason                                                String?
  created_at                                                         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                                         DateTime           @default(now()) @db.Timestamptz(6)
  idempotency_key                                                    String?
  idempotency_fingerprint                                            String?            @db.Char(64)
  application_users_invoices_canceled_by_user_idToapplication_users  application_users? @relation("invoices_canceled_by_user_idToapplication_users", fields: [canceled_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application_users_invoices_confirmed_by_user_idToapplication_users application_users? @relation("invoices_confirmed_by_user_idToapplication_users", fields: [confirmed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application_users_invoices_created_by_user_idToapplication_users   application_users? @relation("invoices_created_by_user_idToapplication_users", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents                                                          documents?         @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_drafts                                                     invoice_drafts?    @relation(fields: [source_draft_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers                                                          suppliers          @relation(fields: [supplier_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_supplier_same_tenant_fkey")
  tenants                                                            tenants            @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
