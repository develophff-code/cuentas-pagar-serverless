  tenants            tenants            @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_drafts     invoice_drafts?
  invoices           invoices[]

  @@index([tenant_id, sha256], map: "documents_tenant_hash_idx", where: raw("(sha256 IS NOT NULL)"))
  @@index([tenant_id, status], map: "documents_tenant_status_idx")
}

