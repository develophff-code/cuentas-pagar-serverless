model audit_events {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String?              @db.Uuid
  actor_user_id              String?              @db.Uuid
  actor_whatsapp_identity_id String?              @db.Uuid
  action                     String
  entity_type                String
  entity_id                  String?              @db.Uuid
  source                     String
  metadata                   Json                 @default("{}")
  created_at                 DateTime             @default(now()) @db.Timestamptz(6)
  application_users          application_users?   @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_identities        whatsapp_identities? @relation(fields: [actor_whatsapp_identity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                    tenants?             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, created_at(sort: Desc)], map: "audit_events_tenant_created_idx")
}

