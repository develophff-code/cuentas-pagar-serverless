  payment_batches_payment_batches_proposed_by_user_idToapplication_users      payment_batches[]     @relation("payment_batches_proposed_by_user_idToapplication_users")
  payment_batches_payment_batches_reversed_by_user_idToapplication_users      payment_batches[]     @relation("payment_batches_reversed_by_user_idToapplication_users")
  subscription_orders                                                         subscription_orders[]
  suppliers                                                                   suppliers[]
  tenant_memberships_tenant_memberships_created_by_user_idToapplication_users tenant_memberships[]  @relation("tenant_memberships_created_by_user_idToapplication_users")
  tenant_memberships_tenant_memberships_user_idToapplication_users            tenant_memberships[]  @relation("tenant_memberships_user_idToapplication_users")
