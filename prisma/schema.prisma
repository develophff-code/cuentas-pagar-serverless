  invoice_drafts_invoice_drafts_reviewed_by_user_idToapplication_users        invoice_drafts[]      @relation("invoice_drafts_reviewed_by_user_idToapplication_users")
  invoices_invoices_canceled_by_user_idToapplication_users                    invoices[]            @relation("invoices_canceled_by_user_idToapplication_users")
  invoices_invoices_confirmed_by_user_idToapplication_users                   invoices[]            @relation("invoices_confirmed_by_user_idToapplication_users")
  invoices_invoices_created_by_user_idToapplication_users                     invoices[]            @relation("invoices_created_by_user_idToapplication_users")
